PORT=8080
DATABASE_PATH=/data/afterjob.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_REVIEW_URL=

# Wait after completed_at before the CSAT ask. Production default is 90.
# For a first smoke test, set DELAY_MINUTES=0 so you do not wait 90 minutes.
DELAY_MINUTES=90
HAPPY_THRESHOLD=4

# Empty disables the inbound webhook (POST /hooks/jobs returns 403).
WEBHOOK_SECRET=

FROM_NAME=
FROM_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy the CSAT email without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional footer link labeled "Powered by AfterJob". Leave empty for no footer.
MARKETING_URL=
